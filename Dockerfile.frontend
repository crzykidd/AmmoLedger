FROM node:20.19.1-slim

WORKDIR /app

# curl needed for HEALTHCHECK
RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

# Run as the base image's built-in `node` user (uid/gid 1000) rather than a
# freshly-created account. In dev, docker-compose.dev.yml bind-mounts
# ./frontend:/app, so /app's ownership is the HOST directory's — uid 1000 for
# the typical developer (and the project-wide PUID/PGID default). A custom
# `adduser` lands on uid 1001 (1000 is already taken by `node`), which then
# cannot write Vite's `vite.config.ts.timestamp-*.mjs` temp file into the
# bind-mounted /app — the dev server crash-loops with EACCES. Reusing `node`
# keeps the container UID aligned with the mount owner. See docs/decisions.md.
COPY --chown=node:node package*.json ./
RUN npm install

COPY --chown=node:node . .

# Give the node user write access to the three paths Vite needs at runtime:
#   /app                    — vite.config.ts.timestamp-*.mjs temp files
#   /app/node_modules       — creating the .vite cache directory
#   /app/node_modules/.vite — dependency optimisation cache
# Pre-creating .vite avoids a chown-R over node_modules on every cold start.
RUN mkdir -p /app/node_modules/.vite \
    && chown -R node:node /app/node_modules/.vite \
    && chown node:node /app/node_modules \
    && chown node:node /app

ARG GIT_SHA=unknown
ARG GIT_BRANCH=main
ENV GIT_SHA=$GIT_SHA \
    GIT_BRANCH=$GIT_BRANCH

USER node

EXPOSE 5173

HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:5173 || exit 1

CMD ["npm", "run", "dev", "--", "--host"]
