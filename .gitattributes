# Normalize line endings across platforms.
# Without this, files saved or checked out on Windows can get CRLF endings,
# which breaks shell scripts run inside Linux containers (the shebang is read
# as `#!/bin/sh\r` and exec fails with "no such file or directory").

# Default: let Git decide text vs binary, but always store/checkout text as LF.
* text=auto eol=lf

# Shell scripts MUST be LF — they run inside Linux containers.
*.sh text eol=lf

# Dockerfiles, entrypoints, and common config — LF.
Dockerfile* text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.mako text eol=lf

# Windows-only scripts stay CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets — never normalize.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.zip binary
*.db binary
*.woff binary
*.woff2 binary
*.ttf binary
